<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules (API 30 and below).
   auth.xml holds the Firebase id token AND the long-lived refresh token in
   cleartext, so it must never leave the device via backup or transfer.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="auth.xml"/>
</full-backup-content>
