# Copy this file to secrets.properties (same folder) and fill in your own
# Firebase / Google OAuth values. secrets.properties is gitignored.
#
# Firebase console -> Project settings -> General -> Web API Key
ORBIT_FIREBASE_API_KEY=
# google-services.json -> oauth_client entry with client_type 3
ORBIT_GOOGLE_WEB_CLIENT_ID=
# Google Cloud console -> Credentials -> OAuth client (Desktop app)
ORBIT_GOOGLE_DESKTOP_CLIENT_ID=
ORBIT_GOOGLE_DESKTOP_CLIENT_SECRET=
